<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="25.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" />
    </padding>
    <Label text="Інтегрування функції методом лівих прямокутників">
        <VBox.margin>
            <Insets left="15.0" top="15.0" />
        </VBox.margin>
        <font>
            <Font name="System Bold Italic" size="12.0" />
        </font>
    </Label>
    <ImageView fitHeight="79.0" fitWidth="159.0" preserveRatio="true">
        <Image url="@img/function.png" />
    </ImageView>
    <GridPane alignment="CENTER" vgap="30.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="169.0" minWidth="10.0" prefWidth="135.0" />
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="300.99999237060547" minWidth="10.0" prefWidth="217.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
        <Label prefHeight="18.0" prefWidth="135.0" text="Кількість інтервалів (n)" />
        <Label prefHeight="18.0" prefWidth="94.0" text="Кількість потоків" GridPane.rowIndex="1" />
        <TextField fx:id="nField" GridPane.columnIndex="1" />
        <TextField fx:id="threadsField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
    </GridPane>
    <Button mnemonicParsing="false" onAction="#calculate" text="Обчислити"> </Button>
    <VBox spacing="15.0">
        <Label fx:id="resultLabel">
            <font>
                <Font name="System Italic" size="15.0"/>
            </font>
        </Label>
        <Label fx:id="timeLabel">
            <font>
                <Font name="System Italic" size="15.0"/>
            </font>
        </Label>
    </VBox>
</VBox>
